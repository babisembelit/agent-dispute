# Solana RPC endpoint
SOLANA_RPC_URL=http://127.0.0.1:8899

# Agent Dispute program ID (set after deployment)
PROGRAM_ID=

# Arbiter keypair path
ARBITER_KEYPAIR_PATH=~/.config/solana/id.json

# LLM API keys (at least one required for arbiter service)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Arbiter poll interval in seconds
POLL_INTERVAL_SECS=5
